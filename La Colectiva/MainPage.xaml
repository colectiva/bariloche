<Page
    x:Class="La_Colectiva.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:La_Colectiva"
    xmlns:controls="using:La_Colectiva.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    xmlns:converters="using:La_Colectiva.Views.Converters"
    >
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:RouteStatusConverter x:Key="RouteStatusConverter"/>
        <converters:OperationStatusConverter x:Key="OperationStatusConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:TimeFormatConverter x:Key="TimeFormatConverter" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0"
            Background="{ThemeResource SystemControlPageBackgroundChromeLowBrush}"
            BorderBrush="{ThemeResource SystemControlForegroundBaseLowBrush}"
            BorderThickness="0,0,0,1"
            Padding="12,0,12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="15" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <SymbolIcon Symbol="MapPin" Grid.Row="0" Grid.Column="0" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                <controls:DockSelector Header="Desde" Grid.Row="0" Grid.Column="1"
                               SelectedDock="{x:Bind From, Mode=TwoWay}" VerticalAlignment="Center" />

                <SymbolIcon Symbol="Flag" Grid.Row="1" Grid.Column="0" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                <controls:DockSelector Header="Hasta" Grid.Row="1" Grid.Column="1"
                               SelectedDock="{x:Bind To, Mode=TwoWay}" />
                <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10">

                    <controls:DateTimePickerButton Grid.Column="0"
            Date="{Binding Date, Mode=TwoWay}" 
            Time="{Binding Time, Mode=TwoWay}" 
            Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>
        <ProgressBar Grid.Row="1" x:Name="LoadingProgress"
             IsIndeterminate="True" 
             HorizontalAlignment="Stretch" 
             VerticalAlignment="Top" 
             Visibility="{Binding Loading, Converter={StaticResource BooleanToVisibilityConverter}}" />
        <ListBox Grid.Row="2" x:Name="LstTrips" Visibility="Collapsed" Background="Transparent" Margin="0" HorizontalContentAlignment="Stretch" SelectionChanged="LstTrips_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Margin" Value="0,0,0,0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                               FontSize="18" FontWeight="SemiBold" 
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}">
                                <Run Text="{Binding Start.Time, Converter={StaticResource TimeFormatConverter}}"/>
                                <Run Text=" → " Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                <Run Text="{Binding End.Time, Converter={StaticResource TimeFormatConverter}}"/>
                            </TextBlock>

                            <TextBlock Grid.Column="1" 
                               Text="{Binding Branch.Company.Name}" 
                               Style="{StaticResource BodyTextBlockStyle}"
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                               VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding Branch.Name}"
                                       Style="{StaticResource BodyTextBlockStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           Margin="0,0,0,4"/>
                        <TextBlock Visibility="{Binding HasOperation, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{Binding OperationStatusBrush}" 
                                   TextWrapping="Wrap"
                                   Margin="0,2,0,0">
                            <Run Text="{Binding OperationStatusText}" FontWeight="SemiBold"/>
                            <Run Text="{Binding OperationMessageText}"/>
                        </TextBlock>
                        <TextBlock Text="{Binding OriginalScheduleText}"
                                   Visibility="{Binding HasOriginalScheduleVisibility}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListView x:Name="TripShortcutListBox" Grid.Row="2"
          HorizontalAlignment="Stretch" SelectionChanged="TripShortcutListBox_SelectionChanged"
          VerticalAlignment="Stretch"
          SelectionMode="Single">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="12,10"/>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="ShortcutGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- Origen (Muelle Desde) -->
                            <ColumnDefinition Width="*" />

                            <!-- Icono Flecha central -->
                            <ColumnDefinition Width="Auto" />

                            <!-- Destino (Muelle Hasta) -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" 
                          Glyph="&#xE81C;" 
                          FontFamily="Segoe MDL2 Assets" 
                          FontSize="16" 
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                          Margin="12,0" 
                          VerticalAlignment="Center"/>
                        <!-- MUELLE ORIGEN -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding From.Name}" 
                               FontSize="14" 
                               TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding From.Via.PrettyName}" 
                               FontSize="12" 
                               Foreground="Gray" 
                               TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- FLECHA / ICONO DE CONEXIÓN -->
                        <FontIcon Grid.Column="2" 
                          Glyph="&#xE72A;" 
                          FontFamily="Segoe MDL2 Assets" 
                          FontSize="16" 
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                          Margin="12,0" 
                          VerticalAlignment="Center"/>

                        <!-- MUELLE DESTINO -->
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding To.Name}" 
                               FontSize="14" 
                               TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding To.Via.PrettyName}" 
                               FontSize="12" 
                               Foreground="Gray" 
                               TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="DeleteShortcutBtn" Visibility="Collapsed" Icon="Delete" Label="Quitar de favoritos" Click="DeleteShortcutBtn_Click" />
            <AppBarButton x:Name="AddShortcutBtn" Visibility="Collapsed" Icon="OutlineStar" Label="Guardar viaje" Click="AddShortcutBtn_Click" />
            <AppBarButton x:Name="NotifyMeBtn" Icon="Comment" Label="Avisarme" Visibility="Collapsed" Click="AppBarButton_Click" />
            <AppBarButton Icon="Switch" Label="Invertir" Click="SwitchDocks_Click"/>
            <AppBarButton Icon="Find" Label="Buscar" Click="SearchNextTrip_Click"/>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
