<ContentDialog
    x:Class="La_Colectiva.Views.Dialogs.ErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:La_Colectiva.Views.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Error"
    PrimaryButtonText="Aceptar">

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 1. Ícono de Advertencia -->
        <TextBlock Grid.Row="0" Grid.Column="0" 
                   Text="&#xE7BA;" 
                   FontFamily="Segoe MDL2 Assets" 
                   Foreground="#D98A00" 
                   x:Name="txtIcon"
                   FontSize="28" 
                   Margin="10,0,15,0" 
                   Grid.RowSpan="2"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center" />

        <!-- 2. Título -->
        <TextBlock Grid.Row="0" Grid.Column="1" 
                   Text="Título" 
                   x:Name="txtTitle"
                   FontSize="18" 
                   FontWeight="SemiBold"
                   Foreground="#0078D7" 
                   TextWrapping="Wrap" 
                   VerticalAlignment="Center" />

        <!-- Subtítulo -->
        <TextBlock Grid.Row="1" Grid.Column="1" 
                   Text="" 
                   x:Name="txtSubtitle"
                   Margin="0,5,0,15" 
                   TextWrapping="Wrap"/>

        <!-- 3. Desplegable de detalles -->
        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                  x:Name="chkDetails"
                  Content="Mostrar detalles"
                  Margin="0,5,0,5"
                  Checked="chkDetails_CheckedChanged"
                  Unchecked="chkDetails_CheckedChanged" />

        <ScrollViewer Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                      x:Name="scrollDetails"
                      Visibility="Collapsed"
                      MaxHeight="180"
                      Margin="0,5,0,0">
            <TextBox x:Name="txtFullError"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</ContentDialog>
