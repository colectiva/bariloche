<ContentDialog
    x:Class="La_Colectiva.Views.Dialogs.DockSelectorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:La_Colectiva.Views.Dialogs"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    PrimaryButtonText="Aceptar"
    SecondaryButtonText="Cancelar"
    IsPrimaryButtonEnabled="False"
    Padding="0,0,0,0"
    FullSizeDesired="True"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    PrimaryButtonClick="ContentDialog_PrimaryButtonClick">
    <ContentDialog.Resources>
        <!-- Plantilla compartida para ambas listas -->
        <DataTemplate x:Key="DockItemTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding PrettyDistance}" VerticalAlignment="Center" Foreground="Gray" FontSize="12"/>
                <TextBlock Grid.ColumnSpan="2" Grid.Row="1" Text="{Binding Via.PrettyName}" FontSize="12" Foreground="Gray"/>
            </Grid>
        </DataTemplate>
    </ContentDialog.Resources>

    <Pivot x:Name="MainPivot" Margin="0,5,0,0" SelectionChanged="MainPivot_SelectionChanged">
        <!-- Pestaña 1: Búsqueda -->
        <PivotItem Header="Buscar">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="qTxt" Grid.Row="0" Text="{Binding Q, Mode=TwoWay}" PlaceholderText="Buscar muelles y puntos..." TextChanged="QTxt_TextChanged" Margin="0,0,0,10" />
                <ProgressRing x:Name="progressRing" Visibility="Collapsed" Grid.Row="1" HorizontalAlignment="Center"/>

                <ListView x:Name="lstDocks" Grid.Row="1" ItemTemplate="{StaticResource DockItemTemplate}" SelectionChanged="lstDocks_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Footer>
                        <Button x:Name="btnLoadMore" Content="Cargar más" HorizontalAlignment="Stretch" Margin="0,5,0,0" Visibility="Collapsed" Click="btnLoadMore_Click"/>
                    </ListView.Footer>
                </ListView>

                <TextBlock x:Name="txtEmpty" Text="No se encontraron muelles." Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </PivotItem>

        <!-- Pestaña 2: Favoritos -->
        <PivotItem Header="Favoritos">
            <Grid>
                <ProgressRing x:Name="progressRingFavorites" Visibility="Collapsed" HorizontalAlignment="Center"/>

                <ListView x:Name="lstFavorites" ItemTemplate="{StaticResource DockItemTemplate}" SelectionChanged="lstFavorites_SelectionChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="12,8"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock x:Name="txtEmptyFavorites" Text="No tenés muelles en favoritos." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </PivotItem>
    </Pivot>
</ContentDialog>
