<UserControl
    x:Class="La_Colectiva.Views.Controls.DockSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel>
        <!-- Título superior (ej: "Desde", "Hasta") -->
        <TextBlock x:Name="HeaderTextBlock" Text="Muelle"
                   Margin="4,8,4,4" 
                   Style="{StaticResource BodyTextBlockStyle}" />

        <!-- Botón estilizado tipo TextBox -->
        <Button x:Name="SelectButton" 
                Click="SelectButton_Click"
                HorizontalAlignment="Stretch" 
                HorizontalContentAlignment="Stretch"
                Padding="10,8"
                Background="Transparent"
                BorderBrush="{ThemeResource TextControlBorderBrush}"
                BorderThickness="1">
            <Grid
                HorizontalAlignment="Stretch" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DockTextBlock" 
                       Text="Ningún muelle seleccionado" Grid.Column="0"
                       Foreground="{ThemeResource SystemControlPageTextBaseMediumBrush}" />
                <ProgressRing 
                    x:Name="progressRing" 
                    IsActive="True" 
                    Grid.Column="1" 
                    Margin="10,0,0,0"
                    Visibility="{Binding ProgressBarVisibility}"
                    />
            </Grid>
        </Button>
    </StackPanel>
</UserControl>