<Page
    x:Class="La_Colectiva.Views.Pages.NetworkStationTidePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:La_Colectiva.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:telerikChart="using:Telerik.UI.Xaml.Controls.Chart"
    xmlns:telerikPrimitives="using:Telerik.UI.Xaml.Controls.Primitives"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <telerikChart:RadCartesianChart x:Name="Chart">
            <!-- Ejes del Gráfico -->
            <telerikChart:RadCartesianChart.HorizontalAxis>
                <telerikChart:DateTimeContinuousAxis LabelFormat="{}{0:HH:mm}" 
                                         MajorStep="6" 
                                         MajorStepUnit="Hour"
                                         LabelFitMode="Rotate"
                                         FontSize="10"/>
            </telerikChart:RadCartesianChart.HorizontalAxis>
            <telerikChart:RadCartesianChart.VerticalAxis>
                <telerikChart:LinearAxis Title="Altura (m)"/>
            </telerikChart:RadCartesianChart.VerticalAxis>

            <!-- Serie 1: Datos Observados (Línea Continua) -->
            <telerikChart:LineSeries ItemsSource="{x:Bind ObservedData}"
                                 Stroke="{ThemeResource SystemControlHighlightAccentBrush}"
                                 StrokeThickness="2">
                <telerikChart:LineSeries.ValueBinding>
                    <telerikChart:PropertyNameDataPointBinding PropertyName="Value"/>
                </telerikChart:LineSeries.ValueBinding>
                <telerikChart:LineSeries.CategoryBinding>
                    <telerikChart:PropertyNameDataPointBinding PropertyName="Start"/>
                </telerikChart:LineSeries.CategoryBinding>
            </telerikChart:LineSeries>

            <!-- Serie 2: Pronóstico (Línea Punteada) -->
            <telerikChart:LineSeries ItemsSource="{x:Bind Forecast}"
                                 Stroke="Gray"
                                 StrokeThickness="2"
                                 StrokeDashArray="4 2">
                <telerikChart:LineSeries.ValueBinding>
                    <telerikChart:PropertyNameDataPointBinding PropertyName="Value"/>
                </telerikChart:LineSeries.ValueBinding>
                <telerikChart:LineSeries.CategoryBinding>
                    <telerikChart:PropertyNameDataPointBinding PropertyName="Start"/>
                </telerikChart:LineSeries.CategoryBinding>
            </telerikChart:LineSeries>

            <!-- Modificadores de Interacción (Zoom y Pan multitáctil) -->
            <telerikChart:RadCartesianChart.Behaviors>
                <telerikChart:ChartPanAndZoomBehavior ZoomMode="Horizontal" PanMode="Horizontal"/>
                <telerikChart:ChartTrackBallBehavior ShowIntersectionPoints="True"/>
            </telerikChart:RadCartesianChart.Behaviors>
        </telerikChart:RadCartesianChart>
        <TextBlock 
            x:Name="TitleTxt" Grid.Row="1" Padding="10,10"
            Style="{StaticResource SubheaderTextBlockStyle}"
            Text="{Binding Station.Name, FallbackValue='Estación'}" />
        <ListBox x:Name="DetailsListBox" Grid.Row="2" Background="Transparent">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="15"/>
                    <Setter Property="Margin" Value="0,0,0,0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.Items>
                <ListBoxItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                            Text="{Binding Station.LastTideFull, FallbackValue='—'}"
                            Grid.Row="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Margin="0,0,0,4"
                            />

                        <TextBlock 
                            Text="Último dato observado"
                            Grid.Row="0"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Margin="0,0,0,4"
                            />
                    </Grid>
                </ListBoxItem>
                <ListBoxItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                            Text="{Binding Station.River, FallbackValue='—'}"
                            Grid.Row="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Margin="0,0,0,4"
                            />

                        <TextBlock 
                            Text="Río"
                            Grid.Row="0"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Margin="0,0,0,4"
                            />
                    </Grid>
                </ListBoxItem>
                <ListBoxItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                            Text="{Binding Station.LowTideLevelText, FallbackValue='—'}"
                            Grid.Row="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Margin="0,0,0,4"
                            />

                        <TextBlock 
                            Text="Nivel de marea baja"
                            Grid.Row="0"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Margin="0,0,0,4"
                            />
                    </Grid>
                </ListBoxItem>

                <ListBoxItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                            Text="{Binding Station.WarningLevelText, FallbackValue='—'}"
                            Grid.Row="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Margin="0,0,0,4"
                            />

                        <TextBlock 
                            Text="Nivel de marea alta"
                            Grid.Row="0"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Margin="0,0,0,4"
                            />
                    </Grid>
                </ListBoxItem>

                <ListBoxItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                            Text="{Binding Station.EvacuationLevelText, FallbackValue='—'}"
                            Grid.Row="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Margin="0,0,0,4"
                            />

                        <TextBlock 
                            Text="Nivel de evacuación"
                            Grid.Row="0"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Margin="0,0,0,4"
                            />
                    </Grid>
                </ListBoxItem>

                <ListBoxItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                            Text="{Binding Station.Coordinates, FallbackValue='—'}"
                            Grid.Row="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Margin="0,0,0,4"
                            />

                        <TextBlock 
                            Text="Coordenadas"
                            Grid.Row="0"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Margin="0,0,0,4"
                            />
                    </Grid>
                </ListBoxItem>

                <ListBoxItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock 
                            Text="{Binding Station.SourceName, FallbackValue='—'}"
                            Grid.Row="1"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                            Margin="0,0,0,4"
                            />

                        <TextBlock 
                            Text="Red"
                            Grid.Row="0"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                            Margin="0,0,0,4"
                            />
                    </Grid>
                </ListBoxItem>
            </ListBox.Items>
        </ListBox>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="ShowInStartBtn" Icon="SetTile" Label="Mostrar en el tile" Click="ShowInStartBtn_Click" />
            <AppBarButton x:Name="RefreshBtn" Icon="Refresh" Label="Actualizar" Click="RefreshBtn_Click" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
