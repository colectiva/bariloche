<Page
    x:Class="La_Colectiva.Views.Pages.NextTripPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:La_Colectiva.Views.Pages"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:La_Colectiva.Views.Converters"
    xmlns:design="using:La_Colectiva.ViewModels.Design"
    >
    <Page.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:RouteStatusConverter x:Key="RouteStatusConverter"/>
        <converters:OperationStatusConverter x:Key="OperationStatusConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <converters:TimeFormatConverter x:Key="TimeFormatConverter" />

        <design:NextTripList x:Key="MockTrips">

            <!-- Ítem 1: Normal -->
            <design:NextTripMock Status="OK">
                <design:NextTripMock.Start>
                    <design:PointMock Time="15:30:00"/>
                </design:NextTripMock.Start>
                <design:NextTripMock.End>
                    <design:PointMock Time="16:15:00"/>
                </design:NextTripMock.End>
                <design:NextTripMock.Branch>
                    <design:BranchMock Name="Hasta Cruz Colorada por Capitán">
                        <design:BranchMock.Company>
                            <design:CompanyMock Name="Interisleña"/>
                        </design:BranchMock.Company>
                    </design:BranchMock>
                </design:NextTripMock.Branch>
            </design:NextTripMock>

            <!-- Ítem 2: Con Operación Manual / Cancelado -->
            <design:NextTripMock Status="OK">
                <design:NextTripMock.Start>
                    <design:PointMock Time="16:00:00"/>
                </design:NextTripMock.Start>
                <design:NextTripMock.End>
                    <design:PointMock Time="17:10:00"/>
                </design:NextTripMock.End>
                <design:NextTripMock.Branch>
                    <design:BranchMock Name="Hasta Paraná por Capitán">
                        <design:BranchMock.Company>
                            <design:CompanyMock Name="Sturla"/>
                        </design:BranchMock.Company>
                    </design:BranchMock>
                </design:NextTripMock.Branch>
                <design:NextTripMock.Operation>
                    <design:OperationMock ForcedStatus="CANCELLED" ManualMessage="Cancelado por fallas mecánicas."/>
                </design:NextTripMock.Operation>
            </design:NextTripMock>

        </design:NextTripList>
    </Page.Resources>
    <Grid>
        <ListBox x:Name="LstTrips" ItemsSource="{StaticResource MockTrips}" Background="Transparent" Margin="10" HorizontalContentAlignment="Stretch" SelectionChanged="LstTrips_SelectionChanged">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="5"/>
                    <Setter Property="Margin" Value="0,0,0,0"/>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" 
                               FontSize="14" FontWeight="SemiBold" 
                               Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}">
                                <Run Text="{Binding Start.Time, Converter={StaticResource TimeFormatConverter}}"/>
                                <Run Text=" → " Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                <Run Text="{Binding End.Time, Converter={StaticResource TimeFormatConverter}}"/>
                            </TextBlock>

                            <TextBlock Grid.Column="1" 
                               Text="{Binding Branch.Company.Name}" 
                               FontSize="12" 
                               Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}" 
                               VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{Binding Branch.Name}" 
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemControlForegroundBaseHighBrush}"
                           Margin="0,0,0,4"/>
                        <TextBlock Visibility="{Binding HasOperation, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                    FontSize="12" Foreground="#856404" TextWrapping="Wrap">
                            <Run Text="{Binding Operation.ForcedStatus, Converter={StaticResource OperationStatusConverter}}" FontWeight="SemiBold"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding Operation.ManualMessage}"/>
                        </TextBlock>
                        <TextBlock Visibility="{Binding HasOriginalSchedule, Converter={StaticResource BooleanToVisibilityConverter}}"
                       FontSize="12" 
                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                       Margin="0,4,0,0">
                            <Run Text="Horario habitual: "/>
                            <Run Text="{Binding OriginalSchedule.Start.Time, Converter={StaticResource TimeFormatConverter}}"/>
                            <Run Text=" → "/>
                            <Run Text="{Binding OriginalSchedule.End.Time, Converter={StaticResource TimeFormatConverter}}"/>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
